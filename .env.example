# Copy this file to .env and fill in your own values.
# .env is in .gitignore and must never be committed.

# Trading 212 API credentials (generate in the Trading 212 app)
T212_API_KEY=
T212_API_SECRET=
# "demo" or "live". Orders are only ever placed on demo.
T212_ENV=demo

# Telegram alerts (optional, used from week 6)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
